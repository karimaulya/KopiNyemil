<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp"><shape android:shape="rectangle">
                <solid android:color="@color/black"/>
                <corners android:radius="10dp"/>
            </shape></item>
            <item android:right="3dp" android:bottom="3dp"><shape android:shape="rectangle">
                <solid android:color="#FFF1CC"/>
                <stroke android:width="2dp" android:color="@color/black"/>
                <corners android:radius="10dp"/>
            </shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="3dp" android:top="3dp"><shape android:shape="rectangle">
                <solid android:color="@color/black"/>
                <corners android:radius="10dp"/>
            </shape></item>
            <item android:right="3dp" android:bottom="3dp"><shape android:shape="rectangle">
                <solid android:color="@color/white"/>
                <stroke android:width="2dp" android:color="@color/black"/>
                <corners android:radius="10dp"/>
            </shape></item>
        </layer-list>
    </item>
</selector>
