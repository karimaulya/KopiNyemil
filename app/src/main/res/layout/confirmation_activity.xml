<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:clipToPadding="false"
    android:background="@color/retro_kuning">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvConfirmGreeting"
        style="@style/RetroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Order Received!" />

    <TextView
        android:id="@+id/tvConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_card_cream"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="25dp"
        android:paddingBottom="25dp"
        android:text="Thanks for ordering at Kopé dan Nyemil. Sit back and relax, your treats are being prepared and will be on their way to you soon!"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/imgKopi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="-24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="-24dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/kopi_decor_hijau_rata" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnOke"
        style="@style/RetroButton"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_ungu"
        android:text="Awesome!"
        android:textColor="@color/white" />
</LinearLayout>
