<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/retro_ungu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitleProfile"
            style="@style/RetroTitle"
            android:textColor="@color/retro_cream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Your Profile" />


        <TextView
            android:id="@+id/tvProfileDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep your details updated so your orders always reach the right person."
            android:textColor="@color/retro_cream"
            android:textSize="16sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgProfileAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_oval_kuning"
                android:contentDescription="Avatar Profile"
                android:padding="16dp"
                android:src="@drawable/profil_logo" />

            <TextView
                android:id="@+id/tvProfileUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_box_pink"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="username"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>


        <TextView
            style="@style/RetroLabel"
            android:layout_marginTop="8dp"
            android:text="Full Name"
            android:textColor="@color/retro_cream" />

        <EditText
            android:id="@+id/etProfileName"
            style="@style/RetroInput"
            android:hint="Full name..."
            android:importantForAutofill="no"
            android:inputType="textPersonName" />

        <TextView
            style="@style/RetroLabel"
            android:layout_marginTop="8dp"
            android:text="Username"
            android:textColor="@color/retro_cream" />

        <EditText
            android:id="@+id/etProfileUsername"
            style="@style/RetroInput"
            android:hint="Username..."
            android:importantForAutofill="no"
            android:inputType="text" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveProfile"
            style="@style/RetroButton"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_btn_kuning"
            android:text="Save Changes"
            android:textColor="@color/black" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            style="@style/RetroButton"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_cream"
            android:text="Logout" />
    </LinearLayout>
</ScrollView>
