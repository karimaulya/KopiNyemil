<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/retro_hijau"
    android:clipToPadding="false"
    >


    <ImageView
        android:id="@+id/imgFries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="-24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="-24dp"
        android:layout_marginBottom="16dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/fries_decor_kuning_rata" />


    <TextView
        android:id="@+id/tvTitle"
        style="@style/RetroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/retro_cream"
        android:text="Sign Up" />


    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ready for some tasty treats today? Join us as a member to make ordering your daily coffee and snacks a breeze!"
        android:textColor="@color/retro_cream"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnRegister"
        style="@style/RetroButton"
        android:background="@drawable/bg_btn_biru"
        android:text="Create New Account"
        android:textColor="@color/retro_cream" />

    <Button
        android:id="@+id/btnLogin"
        style="@style/RetroButton"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_cream"
        android:text="Already a Member" />
</LinearLayout>
