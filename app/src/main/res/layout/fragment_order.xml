<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/retro_pink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">


        <TextView
            android:id="@+id/tvOrderTitle"
            style="@style/RetroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Where to?" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Write down your exact address so our delivery rider won't get lost bringing your coffee."
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Order Items Preview Card -->
        <LinearLayout
            android:id="@+id/cardOrderPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_cream"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Items"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderItemsPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Belum ada menu yang dipilih"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/black" />

            <TextView
                android:id="@+id/tvOrderTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: Rp0"
                android:textColor="@color/retro_ungu"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/RetroLabel"
            android:layout_marginTop="32dp"
            android:text="Full Name" />

        <EditText
            android:id="@+id/etOrderName"
            style="@style/RetroInput"
            android:hint="Receiver's Name"
            android:importantForAutofill="no"
            android:inputType="textPersonName" />

        <TextView
            style="@style/RetroLabel"
            android:text="Address" />

        <EditText
            android:id="@+id/etOrderAddress"
            style="@style/RetroInput"
            android:gravity="top|start"
            android:hint="Full Address (Street, House No.)"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textPostalAddress"
            android:minLines="3" />

        <TextView
            style="@style/RetroLabel"
            android:text="Landmark" />

        <EditText
            android:id="@+id/etOrderDetail"
            style="@style/RetroInput"
            android:gravity="top|start"
            android:hint="Landmark (e.g., Green gate)"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnOrder"
            style="@style/RetroButton"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_btn_biru"
            android:text="Order &amp; Deliver Now"
            android:textColor="@color/retro_cream" />
    </LinearLayout>
</ScrollView>
