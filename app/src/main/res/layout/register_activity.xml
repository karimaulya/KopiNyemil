<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_box_pink"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:text="🍩 New member"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRegisterTitle"
            style="@style/RetroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Register" />

        <TextView
            android:id="@+id/tvRegisterName"
            style="@style/RetroLabel"
            android:layout_marginTop="32dp"
            android:text="Nama Lengkap" />

        <EditText
            android:id="@+id/etRegisterName"
            style="@style/RetroInput"
            android:hint="nama lengkap"
            android:importantForAutofill="no"
            android:inputType="textPersonName" />

        <TextView
            android:id="@+id/tvRegisterUsernameTitle"
            style="@style/RetroLabel"
            android:text="Username" />

        <EditText
            android:id="@+id/etRegisterUsername"
            style="@style/RetroInput"
            android:hint="username"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvRegisterPasswordTitle"
            style="@style/RetroLabel"
            android:text="Password" />

        <EditText
            android:id="@+id/etRegisterPassword"
            style="@style/RetroInput"
            android:hint="password"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegisterSubmit"
            style="@style/RetroButton"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_btn_hijau"
            android:text="Register"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
