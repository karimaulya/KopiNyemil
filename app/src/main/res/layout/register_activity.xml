<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/retro_pink"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imgKopi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="-24dp"
            android:layout_marginEnd="-24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:src="@drawable/kopi_decor_hijau_rata" />

        <TextView
            android:id="@+id/tvRegisterTitle"
            style="@style/RetroTitle"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Join the Club!" />

        <TextView
            android:id="@+id/tvRegisterDesc"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Fill in these quick details so we can get to know you and deliver your cravings faster." />


        <TextView
            android:id="@+id/tvRegisterName"
            style="@style/RetroLabel"
            android:layout_marginTop="32dp"
            android:text="Full Name" />

        <EditText
            android:id="@+id/etRegisterName"
            style="@style/RetroInput"
            android:hint="Your full name..."
            android:importantForAutofill="no"
            android:inputType="textPersonName" />

        <TextView
            android:id="@+id/tvRegisterUsernameTitle"
            style="@style/RetroLabel"
            android:text="Username" />

        <EditText
            android:id="@+id/etRegisterUsername"
            style="@style/RetroInput"
            android:hint="Pick a unique username..."
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvRegisterPasswordTitle"
            style="@style/RetroLabel"
            android:text="Password" />

        <EditText
            android:id="@+id/etRegisterPassword"
            style="@style/RetroInput"
            android:hint="Your secret password..."
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegisterSubmit"
            style="@style/RetroButton"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_btn_hijau"
            android:text="Register Now"
            android:textColor="@color/retro_cream" />
    </LinearLayout>
</ScrollView>
